# SourceWise environment template
#
# This file is configured for Docker Compose from the repository root.
# Copy it to .env, keep secret values in files under secrets/, and never commit .env.

# Application
APP_ENV=docker
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Authentication and token lifetimes
SECRET_KEY_FILE=/app-secrets/secret_key.txt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Email
EMAIL_FROM=Sourcewise <no-reply@notifications.ibrahimherawi.com>
RESEND_API_KEY_FILE=/app-secrets/resend_api_key.txt
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=

# Chat provider
AI_PROVIDER=ollama
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_API_KEY_FILE=/app-secrets/openai_api_key.txt
OLLAMA_OPENAI_BASE_URL=http://ollama:11434/v1
OLLAMA_CHAT_MODEL=llama3.2:1b
LLM_CONNECT_TIMEOUT_S=5
LLM_READ_TIMEOUT_S=60
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_MIN_WAIT_S=0.5
LLM_RETRY_MAX_WAIT_S=4

# Embeddings and retrieval
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBED_CONCURRENCY=4
OLLAMA_EMBED_BATCH_SIZE=32
OLLAMA_EMBED_READ_TIMEOUT_S=120
RETRIEVAL_MAX_COSINE_DISTANCE=0.75
RETRIEVAL_SEMANTIC_ACCEPT_DISTANCE=0.35
RETRIEVAL_LEXICAL_ACCEPT_DISTANCE=0.55
RETRIEVAL_MIN_QUERY_TERM_COVERAGE=0.60
TOP_K=5

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_DB=app_db
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password.txt

# Ingestion and uploads
INGEST_WORKERS=2
INGEST_SHUTDOWN_TIMEOUT_S=30
CHUNK_SIZE_CHARS=2000
CHUNK_OVERLAP_CHARS=100
MAX_UPLOAD_MB=10

# Frontend and server-side API proxy
BACKEND_INTERNAL_URL=http://api:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
